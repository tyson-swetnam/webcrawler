# Python
*.log
*.pyc
__pycache__/
.env
venv/

# Claude-generated files and logs
claude_thoughts/
log/

# IDEs
.vscode/
.idea/
.claude/

# Output directories (except docs/)
html_output/
output/
examples/

# Keep GitHub Pages directory for commit
!docs/
